+// Writes a tree decomposition of a chordal graph in the PACE 2017 .td format.
+// The bags are the vertices of a perfect elimination order together with
+// their later neighbours; the parent of a bag is the bag of its earliest
+// later neighbour. Vertex labels are mapped back to the input's labels, and
+// vertices named only by the "p tw n m" header (isolated vertices, which the
+// reader never sees) get bags of their own. The bags of the components are
+// chained so the output is one tree.
+void PrintTreeDecomposition(const Graph& chordal, Io& io, int header_n) {
+  int n = chordal.n();
+  std::vector<int> order = mcs::Mcs(chordal);
+  std::vector<int> pos = utils::PermInverse(order);
+  std::vector<std::vector<int>> bags(n);
+  std::vector<int> parent(n, -1);
+  std::vector<char> seen(std::max(header_n, 0) + 1, 0);
+  for (int i = 0; i < n; i++) {
+    int x = order[i];
+    int label = std::stoi(io.MapBack(x));
+    if (label >= 1 && label < (int)seen.size()) seen[label] = 1;
+    bags[i].push_back(label);
+    for (int nx : chordal.Neighbors(x)) {
+      if (pos[nx] > i) {
+        bags[i].push_back(std::stoi(io.MapBack(nx)));
+        if (parent[i] == -1 || pos[nx] < parent[i]) parent[i] = pos[nx];
+      }
+    }
+  }
+  for (int label = 1; label < (int)seen.size(); label++) {
+    if (!seen[label]) {
+      bags.push_back({label});
+      parent.push_back(-1);
+    }
+  }
+  int num_vertices = std::max(header_n, n);
+  size_t max_bag = 1;
+  for (const auto& bag : bags) max_bag = std::max(max_bag, bag.size());
+  std::cout<<"s td "<<bags.size()<<" "<<max_bag<<" "<<num_vertices<<"\n";
+  for (size_t i = 0; i < bags.size(); i++) {
+    std::cout<<"b "<<i+1;
+    for (int v : bags[i]) std::cout<<" "<<v;
+    std::cout<<"\n";
+  }
+  int prev_root = -1;
+  for (size_t i = 0; i < bags.size(); i++) {
+    if (parent[i] != -1) {
+      std::cout<<parent[i]+1<<" "<<i+1<<"\n";
+    } else {
+      if (prev_root != -1) std::cout<<prev_root+1<<" "<<i+1<<"\n";
+      prev_root = i;
+    }
+  }
+  std::cout.flush();
+}
